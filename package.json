{
  "name": "nok-nok",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.21.1"
  },
  "workspaces": [
    "apps/*"
  ],

  "scripts": {
    "start": "npm run start:dev -w @nok-nok/api",
    "start:api": "npm run start:dev -w @nok-nok/api",
    "start:web": "npm run start -w @nok-nok/web",
    "start:dev": "npm run start:api & npm run start:web",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w @nok-nok/web",
    "build:api": "npm run build -w @nok-nok/api",
    "start:prod": "npm run start:prod -w @nok-nok/api",
    "test": "npm run test -w @nok-nok/web",
    "test:web": "npm run test -w @nok-nok/web"
  }
}
