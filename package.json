{
  "name": "nok-nok",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Nok Nok — NestJS API + Angular web",
  "engines": {
    "node": "22.21.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "certs": "node scripts/generate-certs.mjs",
    "predev": "node scripts/generate-certs.mjs",
    "dev": "node scripts/start-dev.mjs",
    "build": "npm run build --workspace=@nok-nok/web && npm run build --workspace=@nok-nok/api",
    "start": "NODE_ENV=production npm run start:prod --workspace=@nok-nok/api",
    "start:api": "npm run start:dev --workspace=@nok-nok/api",
    "start:web": "npm run start --workspace=@nok-nok/web"
  }
}
