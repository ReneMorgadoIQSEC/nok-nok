{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected|Local:"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)|Local:"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "start:api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Starting|watching"
          },
          "endsPattern": {
            "regexp": "API listening|Nest application successfully started"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ]
}
