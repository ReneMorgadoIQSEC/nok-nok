PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Base URL of the external FIDO / identity provider (leave empty for local stub)
EXTERNAL_FIDO_BASE_URL=

# IQSEC Utilities API (OTP send / verify)
EXTERNAL_UTILITIES_BASE_URL=https://investigacion.iqsec.com.mx:8013/Utilities

# Optional API key forwarded to external services
EXTERNAL_API_KEY=

# Path to the Angular production build. Defaults to ../web/dist/web/browser
WEB_DIST_PATH=
